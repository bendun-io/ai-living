meta {
  name: Item - Delete
  type: http
  seq: 10
}

post {
  url: {{utils_lists_base_url}}/items/delete
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "{{item_id}}",
    "actor": "bruno"
  }
}

assert {
  res.status: eq 200
  res.body.item.id: isDefined
  res.body.audit_id: isDefined
}

script:post-response {
  const auditId = res.body?.audit_id;
  if (auditId) {
    bru.setVar("audit_id", auditId);
    bru.setVar("item_delete_audit_id", auditId);
  }
}
