meta {
  name: List - Search
  type: http
  seq: 4
}

post {
  url: {{utils_lists_base_url}}/lists/search
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "query": "Project",
    "include_deleted": false,
    "limit": 20,
    "offset": 0
  }
}

assert {
  res.status: eq 200
  res.body.lists: isDefined
}

script:post-response {
  const lists = res.body?.lists;
  if (Array.isArray(lists) && lists.length > 0 && lists[0]?.id) {
    bru.setVar("list_id", lists[0].id);
  }
}
