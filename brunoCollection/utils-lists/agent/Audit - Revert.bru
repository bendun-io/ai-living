meta {
  name: Audit - Revert
  type: http
  seq: 15
}

post {
  url: {{utils_lists_base_url}}/audit/revert
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "audit_id": "{{audit_id}}",
    "actor": "bruno"
  }
}

assert {
  res.status: eq 200
  res.body.reverted: eq true
  res.body.reverted_audit_id: isDefined
}

script:post-response {
  const revertAuditId = res.body?.reverted_audit_id;
  if (revertAuditId) {
    bru.setVar("reverted_audit_id", revertAuditId);
  }
}
