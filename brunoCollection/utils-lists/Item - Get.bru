meta {
  name: Item - Get
  type: http
  seq: 6
}

post {
  url: {{utils_lists_base_url}}/items/get
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "{{item_id}}",
    "include_deleted": false
  }
}

assert {
  res.status: eq 200
  res.body.item.id: isDefined
}
