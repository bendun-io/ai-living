meta {
  name: 2 - Add First Result To Cart
  type: http
  seq: 2
}

post {
  url: {{rewe_service_base_url}}/cart/add
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "productId": "{{rewe_product_id}}",
    "quantity": 1
  }
}

assert {
  res.status: eq 200
  res.body.added: eq true
}
