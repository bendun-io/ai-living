meta {
  name: List - Create
  type: http
  seq: 1
}

post {
  url: {{utils_lists_base_url}}/lists
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "REST Test List",
    "description": "Created via Bruno REST",
    "actor": "bruno-rest"
  }
}

assert {
  res.status: eq 200
  res.body.list.id: isDefined
  res.body.audit_id: isDefined
}

script:post-response {
  bru.setVar("rest_list_id", res.body?.list?.id);
  bru.setVar("rest_audit_id", res.body?.audit_id);
}
